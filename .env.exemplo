# Senhas e nomes de rede do projeto - MODELO. Copie para ".env" e preencha
# com os dados reais (o .env fica fora do git).
#
# O firmware nao le este arquivo sozinho (o ESP32 e compilado pelo Arduino
# IDE). Depois de alterar, rode:
#     python ferramentas/gerar_segredos.py
# para atualizar firmware/controle_producao_horimetro/segredos.h e grave o
# firmware de novo.

# Rede da empresa (o ESP32 entra nela como mais um aparelho).
EMPRESA_SSID_PADRAO=NOME_DA_REDE
EMPRESA_SENHA_PADRAO=SENHA_DA_REDE

# Rede propria criada pelo ESP32 (http://192.168.4.1). AP_SENHA tambem e a
# senha pedida para salvar alteracoes na pagina de configuracao do ESP32.
# Minimo 8 caracteres.
AP_SSID=HORIMETRO_SANTEX
AP_SENHA=TROQUE_ESTA_SENHA
