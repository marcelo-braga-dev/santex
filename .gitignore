# ---- Senhas - modelo versionado: .env.exemplo ----
.env
# gerado a partir do .env por ferramentas/gerar_segredos.py
firmware/**/segredos.h
app/segredos_app.json
app/build_info.json
# backups automaticos do banco (app/caminhos.py dir_backup) - nunca versionar
/backup/

# ---- Gerados pelo build do executavel (app/gerar_executavel.bat) ----
app/build/
app/dist/
app/*.spec

# ---- Python ----
__pycache__/
*.py[cod]

# ---- Dados locais (banco, logs, estado) - nunca versionar ----
dados/*.db
dados/*.db-shm
dados/*.db-wal
dados/*.log
dados/backups/
dados/backup.json
dados/seguranca.json
dados/nuvem.json
dados/nuvem_status.json
dados/usuarios.json
dados/sincronizacao.json
dados/conexao.json
dados/esp32_ip_empresa.txt
*.log
*.migrado

# ---- Perfil do navegador embutido (WebView2) ----
perfil_webview/

# ---- Copias manuais antigas (o historico agora fica no git) ----
**/_backup/

# ---- Sistema / editores ----
Thumbs.db
desktop.ini
.vscode/
.idea/
