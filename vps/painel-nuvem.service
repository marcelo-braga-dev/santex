# Painel de Producao - servidor do acesso remoto (modo nuvem) na VPS.
# Instalado por vps/instalar.sh em /etc/systemd/system/.
# Logs: journalctl -u painel-nuvem -f
[Unit]
Description=Painel de Producao - acesso remoto (modo nuvem)
After=network-online.target
Wants=network-online.target

[Service]
User=painel
Group=painel
WorkingDirectory=/opt/painel-nuvem
# NUVEM_CHAVE (a mesma do .env da fabrica) fica so neste arquivo, fora do codigo
EnvironmentFile=/etc/painel-nuvem.env
Environment=PAINEL_MODO=nuvem
Environment=PAINEL_DADOS=/var/lib/painel-nuvem
Environment=PAINEL_PORTA=8080
Environment=PAINEL_ESCUTA=127.0.0.1
# horarios do painel e do banco no fuso da fabrica
Environment=TZ=America/Sao_Paulo
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 ferramentas/controle_leitura_server.py
Restart=always
RestartSec=5

# isolamento: so escreve na pasta de dados
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/painel-nuvem
# sem privilegios nem acesso ao kernel/dispositivos (a VPS nao usa serial)
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0027
# um vazamento de memoria nao derruba os outros sites da VPS
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
